MAIL_API_BIND=127.0.0.1
MAIL_API_PORT=8788
MAIL_API_PUBLIC_BASE=https://mail-code.example.com
MAIL_API_DATA_DIR=/data
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(36))"
MAIL_API_ADMIN_TOKEN=replace-with-a-long-random-token
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_API_MASTER_KEY=replace-with-a-fernet-key
MAIL_API_UPSTREAM_TIMEOUT=25
MAIL_API_RATE_LIMIT=30
# Browser TLS/HTTP fingerprint used for mail.com login.
MAIL_HTTP_IMPERSONATE=chrome136
# Private one-proxy-per-line file. New accounts receive the next unused entry once.
MAIL_API_PROXY_POOL_FILE=/etc/mail-com-code-api-proxies.txt
# Public SPA secret shipped by the mail.com frontend; override when rotated.
MAIL_OAUTH_PUBLIC_SECRET=*******
